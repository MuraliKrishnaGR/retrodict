# Muse Spark Open via an OpenAI-compatible host (default: Baseten).
# Set the key with: python scripts/set_key.py   (never commit .env)
LLM_API_KEY=paste_your_key_here
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open

# SAM 3.1 open weights, run locally (first run downloads ~1.7 GB)
SAM_MODEL_ID=unsloth/sam3.1

# Safety limits (USD, estimated from token usage)
MAX_SPEND_USD=50
MAX_RUN_USD=1.00

# Muse Image (Meta Model API) for generated rewind frames: a Meta model, so allowed, but it needs a card
# on the Meta account. Set the key with: python scripts/set_meta_key.py
META_API_KEY=
META_IMAGE_MODEL=muse-image-1.0
