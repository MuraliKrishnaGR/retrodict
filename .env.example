# Muse Spark Open through any OpenAI-compatible host (Baseten, OpenRouter, Together, Fireworks, Modal...).
# Easiest: python scripts/use_host.py <host>   (asks for the key hidden and fills these in; never commit .env)
LLM_API_KEY=paste_your_key_here
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open
LLM_REASONING_EFFORT=high
LLM_MAX_TOKENS=20000
LLM_MAX_RETRIES=8

# SAM 3.1 open weights, run locally (first run downloads ~1.7 GB)
SAM_MODEL_ID=unsloth/sam3.1

# Safety limits (USD, estimated from token usage)
MAX_SPEND_USD=50
MAX_RUN_USD=1.00
